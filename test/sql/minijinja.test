# name: test/sql/minijinja.test
# description: test minijinja extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT minijinja_render('');
----
Catalog Error: Scalar Function with name minijinja_render does not exist!

# Require statement will ensure this test is run with this extension loaded
require minijinja

# Test minijinja_render (template only, no context)
query T
SELECT minijinja_render('Hello World!')
----
Hello World!

# Test minijinja_render with optional parameters
query T
SELECT minijinja_render('Hello & Goodbye!', autoescape := false)
----
Hello & Goodbye!

# Render the template with a JSON context as the second argument
query T
SELECT minijinja_render_with_context('{{ foo }}', '{"foo": "bar"}')
----
bar

# Demonstrate that by default autoescaping is applied.
query T
SELECT minijinja_render_with_context('{{ v }}', '{"v": "B&O"}')
----
B&amp;O

# Test that autoescaping can be disabled.
query T
SELECT minijinja_render_with_context('{{ v }}', '{"v": "B&O"}', autoescape := false)
----
B&O


# NOTE: loading a template from a file on disk (template_path) is exercised in
# minijinja.test_slow — it needs host filesystem access, which the wasm build
# does not have, so it is kept out of the default suite.

# Demonstrate the error that happens when a unknown template is specified.
statement error
SELECT minijinja_render_with_context('index2.html', '{"v": "B&O"}', autoescape := false, template_path := './template/')
----
Invalid Input Error: Error rendering template: MiniJinja render error: Error { kind: TemplateNotFound, detail: "template \"index2.html\" does not exist" }

# The options are keyword-only parameters with defaults; duckdb_functions()
# lists them after the positional arguments.
query III
SELECT function_name, parameters, parameter_types
FROM duckdb_functions()
WHERE function_name LIKE 'minijinja_render%'
ORDER BY function_name
----
minijinja_render	[template, autoescape, template_path, undefined_behavior, autoescape_extensions]	[VARCHAR, BOOLEAN, VARCHAR, VARCHAR, 'VARCHAR[]']
minijinja_render_with_context	[template, context, autoescape, template_path, undefined_behavior, autoescape_extensions]	[VARCHAR, JSON, BOOLEAN, VARCHAR, VARCHAR, 'VARCHAR[]']

query II
SELECT description IS NOT NULL, categories
FROM duckdb_functions()
WHERE function_name LIKE 'minijinja_render%'
ORDER BY function_name
----
true	[text, template]
true	[text, template]

# The positional arguments can also be passed by name, in any order.
query T
SELECT minijinja_render_with_context(context := '{"a": 1}', template := '{{ a }}')
----
1

# Explicitly passing the defaults matches the default behavior.
query T
SELECT minijinja_render_with_context('{{ v }}', '{"v": "B&O"}', autoescape := true, template_path := '', undefined_behavior := 'lenient', autoescape_extensions := [])
----
B&amp;O

# The default undefined behavior is lenient: missing variables render empty.
query T
SELECT minijinja_render('[{{ missing }}]')
----
[]

query T
SELECT minijinja_render('[{{ missing }}]', undefined_behavior := 'chainable')
----
[]

statement error
SELECT minijinja_render('{{ missing }}', undefined_behavior := 'strict')
----
Invalid Input Error: Error rendering template: MiniJinja render error: Error { kind: UndefinedError

statement error
SELECT minijinja_render('Hello', undefined_behavior := 'nope')
----
Binder Error: minijinja_render: 'undefined_behavior' argument has invalid value 'nope' must be one of: lenient, strict, chainable, semi_strict

# Unknown option names are rejected.
statement error
SELECT minijinja_render('Hello', bogus := 1)
----
No function matches the given name and argument types 'minijinja_render(STRING_LITERAL, "bogus" := INTEGER_LITERAL)'

statement error
SELECT minijinja_render_with_context('Hello', '{}', autoescap := false)
----
No function matches the given name and argument types

# The options are typed: values that cannot be cast implicitly are rejected.
statement error
SELECT minijinja_render('Hello', autoescape := 1)
----
No function matches the given name and argument types 'minijinja_render(STRING_LITERAL, "autoescape" := INTEGER_LITERAL)'

statement error
SELECT minijinja_render('Hello', autoescape_extensions := [1, 2])
----
No function matches the given name and argument types

# String literals are cast to the declared type.
query T
SELECT minijinja_render('A & B', autoescape := 'false')
----
A & B

# NULL in, NULL out: an explicit NULL option makes the whole result NULL.
query T
SELECT minijinja_render('Hello', autoescape := NULL)
----
NULL

query T
SELECT minijinja_render('Hello', template_path := NULL)
----
NULL

query T
SELECT minijinja_render('Hello', undefined_behavior := NULL)
----
NULL

query T
SELECT minijinja_render('Hello', autoescape_extensions := NULL)
----
NULL

query T
SELECT minijinja_render_with_context('{{ a }}', '{"a": 1}', autoescape := NULL)
----
NULL

query T
SELECT minijinja_render_with_context('{{ a }}', '{"a": 1}', template_path := NULL)
----
NULL

query T
SELECT minijinja_render_with_context('{{ a }}', '{"a": 1}', undefined_behavior := NULL)
----
NULL

query T
SELECT minijinja_render_with_context('{{ a }}', '{"a": 1}', autoescape_extensions := NULL)
----
NULL

# A NULL context also gives NULL.
query T
SELECT minijinja_render_with_context('{{ a }}', NULL)
----
NULL

# The options must be constants.

statement error
SELECT minijinja_render('Hello', autoescape := random() > 0.5)
----
must be a constant expression

statement error
SELECT minijinja_render('Hello', autoescape_extensions := ['html', NULL])
----
Binder Error: minijinja_render: 'autoescape_extensions' must not contain NULL

# The context is a required positional argument of minijinja_render_with_context.
statement error
SELECT minijinja_render_with_context('Hello')
----
No function matches the given name and argument types

# Options are keyword-only: they cannot be passed by position.
statement error
SELECT minijinja_render('Hello', false)
----
No function matches the given name and argument types

# A NULL template renders to NULL.
query T
SELECT minijinja_render(NULL)
----
NULL
